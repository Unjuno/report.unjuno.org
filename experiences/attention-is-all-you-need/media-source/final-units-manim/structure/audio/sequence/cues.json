[
  {
    "start": 0.7,
    "end": 6.026451612903225,
    "text": "再帰型の層では、次の位置の計算に、前の位置の結果が必要です。"
  },
  {
    "start": 6.026451612903225,
    "end": 11.707999999999998,
    "text": "六つの位置で、先頭から末尾までをたどると、五つの接続を通ります。"
  },
  {
    "start": 17.7,
    "end": 22.46750769230769,
    "text": "セルフアテンションは、入力の各位置を直接参照できます。"
  },
  {
    "start": 22.46750769230769,
    "end": 26.705292307692307,
    "text": "六つの位置の先頭と末尾も、一つの接続で結べます。"
  },
  {
    "start": 26.705292307692307,
    "end": 29.177333333333333,
    "text": "これは情報の経路の比較です。"
  },
  {
    "start": 34.7,
    "end": 39.02283544303798,
    "text": "位置を十二に増やすと、隣をたどる経路は十一接続。"
  },
  {
    "start": 39.02283544303798,
    "end": 40.824016877637135,
    "text": "直接なら一接続です。"
  },
  {
    "start": 40.824016877637135,
    "end": 48.92933333333333,
    "text": "原著の表一では、最大経路長を、再帰層はエヌ、セルフアテンションは定数のオーダーで示します。"
  },
  {
    "start": 51.7,
    "end": 56.45087719298246,
    "text": "入力がそろった層では、各位置を並列に計算できます。"
  },
  {
    "start": 56.45087719298246,
    "end": 61.39178947368421,
    "text": "ただし生成では、次の入力に生成済みの出力が必要です。"
  },
  {
    "start": 61.39178947368421,
    "end": 66.14266666666667,
    "text": "短い経路は、実測の速さや、一括生成を意味しません。"
  }
]
