{
  "language": "ja-JP",
  "total_duration": 110,
  "segments": [
    {
      "start": 0.5,
      "end": 4.7,
      "text": "ひとつの言葉は、ひとつでは決まらない。"
    },
    {
      "start": 5.2,
      "end": 11.8,
      "text": "読む、を手がかりに、文の中の情報を見比べます。"
    },
    {
      "start": 11.8,
      "end": 16.8,
      "text": "関係の強さを、情報を混ぜるための重みに変えます。"
    },
    {
      "start": 16.8,
      "end": 24.3,
      "text": "重みをかけて足す。文脈を含んだ、新しい表現ができます。"
    },
    {
      "start": 25,
      "end": 31,
      "text": "同じ入力を、学習した三つの変換で、キュー、ケー、ブイに分けます。"
    },
    {
      "start": 31,
      "end": 36.5,
      "text": "キューとケーを照合し、ソフトマックスで合計一の重みを作ります。"
    },
    {
      "start": 36.5,
      "end": 42,
      "text": "その重みでブイを混ぜる。これがアテンションの計算です。"
    },
    {
      "start": 42.5,
      "end": 48.5,
      "text": "異なる射影で、アテンションを並列に計算します。"
    },
    {
      "start": 48.5,
      "end": 54,
      "text": "複数の出力を結合し、線形変換してまとめます。"
    },
    {
      "start": 54.5,
      "end": 60,
      "text": "単語の情報だけでは、語順の手がかりが足りません。"
    },
    {
      "start": 60,
      "end": 66,
      "text": "埋め込みに位置情報を足し、並び順を伝えます。"
    },
    {
      "start": 66.5,
      "end": 73,
      "text": "元の論文は、エンコーダーとデコーダーを組み合わせたモデルです。"
    },
    {
      "start": 73,
      "end": 79,
      "text": "デコーダーは未来を隠し、エンコーダーの出力も参照します。"
    },
    {
      "start": 79,
      "end": 85,
      "text": "アテンションに加え、フィードフォワードネットワーク、残差接続、正規化を使います。"
    },
    {
      "start": 85.5,
      "end": 92,
      "text": "学習中は、未来を隠したまま、各位置をまとめて計算できます。"
    },
    {
      "start": 92,
      "end": 99,
      "text": "生成するときは、基本的に、一トークンずつ続きを作ります。"
    },
    {
      "start": 99.5,
      "end": 105,
      "text": "情報を選び、混ぜ、何層も更新する。これがトランスフォーマーです。"
    },
    {
      "start": 105,
      "end": 110,
      "text": "ここからは、ひとつの仕組みを短く見て、自分で動かしましょう。"
    }
  ]
}